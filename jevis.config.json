{
  "jev": {
    "model": "jev-latest",
    "autoThreshold": 0.85,
    "minTop": 0.6,
    "minMargin": 0.4,
    "maxChoices": 250
  },
  "browser": {
    "chromePath": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "cdpPort": 9333,
    "profileDir": "~/.jevis/chrome-profile",
    "maxElements": 400,
    "maxTextChars": 4000
  },
  "confirm": {
    "enabled": true,
    "riskThreshold": 0.5,
    "timeoutSec": 120,
    "keywords": [
      "submit",
      "send",
      "publish",
      "pay",
      "purchase",
      "buy",
      "place order",
      "add for review",
      "submit for review",
      "release this version",
      "gönder",
      "yayınla",
      "öde",
      "satın al",
      "sipariş ver",
      "delete app",
      "delete account",
      "empty trash",
      "hesabı sil",
      "çöp sepetini boşalt"
    ],
    "alwaysAsk": [],
    "neverAsk": [],
    "sites": {},
    "keywordFloor": 0.3,
    "softKeywords": [
      "delete",
      "remove",
      "sil",
      "kaldır"
    ]
  },
  "guard": {
    "injectionScan": true,
    "injectionThreshold": 0.7,
    "waitForUserTimeoutSec": 900
  },
  "server": {
    "port": 3000
  },
  "brain": {
    "default": "claude-code",
    "maxSteps": 40,
    "providers": {
      "claude-code": {
        "model": ""
      },
      "anthropic": {
        "model": "claude-opus-5"
      },
      "openai": {
        "baseURL": "https://api.openai.com/v1",
        "apiKeyEnv": "OPENAI_API_KEY",
        "model": ""
      },
      "ollama": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "apiKeyEnv": "",
        "model": ""
      },
      "codex": {}
    }
  }
}
