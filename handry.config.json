{
  "captcha": {
    "key": "",
    "maxWaitSec": 120
  },
  "jev": {
    "model": "jev-latest",
    "autoThreshold": 0.85,
    "minTop": 0.6,
    "minMargin": 0.4,
    "maxChoices": 250
  },
  "browser": {
    "chromePath": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "cdpPort": 9333,
    "profileDir": "~/.jevis/chrome-profile",
    "maxElements": 400,
    "maxTextChars": 4000
  },
  "codes": {
    "ask": true,
    "withinMin": 5,
    "smsDb": "~/Library/Messages/chat.db",
    "gmailUrl": "https://mail.google.com/mail/u/0/#inbox"
  },
  "confirm": {
    "enabled": true,
    "riskThreshold": 0.5,
    "kindCheck": true,
    "timeoutSec": 120,
    "remote": true,
    "remoteAfterSec": 20,
    "remoteTimeoutSec": 600,
    "keywords": [
      "submit",
      "send",
      "publish",
      "pay",
      "purchase",
      "buy",
      "place order",
      "add for review",
      "submit for review",
      "release this version",
      "gönder",
      "yayınla",
      "öde",
      "satın al",
      "sipariş ver",
      "delete app",
      "delete account",
      "empty trash",
      "hesabı sil",
      "çöp sepetini boşalt"
    ],
    "alwaysAsk": [],
    "neverAsk": [],
    "sites": {},
    "keywordFloor": 0.3,
    "softKeywords": [
      "delete",
      "remove",
      "sil",
      "kaldır"
    ]
  },
  "guard": {
    "injectionScan": true,
    "injectionThreshold": 0.7,
    "waitForUserTimeoutSec": 900
  },
  "notify": {
    "imessageTo": "",
    "imessageAfterSec": 60,
    "speak": true
  },
  "learn": {
    "enabled": true,
    "max": 60
  },
  "server": {
    "port": 4263
  },
  "brain": {
    "default": "claude-code",
    "maxSteps": 40,
    "providers": {
      "claude-code": {
        "model": "claude-sonnet-5-5",
        "effort": "high",
        "lean": true,
        "models": [
          "claude-sonnet-5-5",
          "claude-opus-5-5"
        ],
        "efforts": [
          "medium",
          "high",
          "xhigh"
        ]
      },
      "anthropic": {
        "model": "claude-sonnet-5-5"
      },
      "openai": {
        "baseURL": "https://api.openai.com/v1",
        "apiKeyEnv": "OPENAI_API_KEY",
        "model": ""
      },
      "ollama": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "apiKeyEnv": "",
        "model": ""
      },
      "codex": {}
    }
  },
  "voice": {
    "model": "~/.jevis/models/ggml-large-v3-turbo-q5_0.bin",
    "language": "tr",
    "ttsVoice": "Yelda",
    "maxSpokenChars": 320,
    "recordSeconds": 6
  }
}
